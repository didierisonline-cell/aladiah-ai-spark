{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aladiah.com/schemas/language/language_review_queue.schema.json",
  "title": "Language Review Queue Item",
  "description": "A work item for the AI/human review pipeline that gates student submissions and machine translations before they become official. Maps to language_review_queue.",
  "type": "object",
  "additionalProperties": false,
  "required": ["target_table", "target_id", "language", "stage", "status"],
  "properties": {
    "id": { "type": "string", "description": "UUID." },
    "target_table": {
      "type": "string",
      "description": "Which table the item under review lives in.",
      "enum": ["language_student_submissions","language_translation_memory","language_vocabulary_entries"]
    },
    "target_id": { "type": "string", "description": "Row id under review." },
    "language": { "type": "string" },
    "stage": {
      "type": "string",
      "description": "Current pipeline stage.",
      "enum": ["ai-review","human-review"]
    },
    "status": {
      "type": "string",
      "enum": ["pending","in-progress","approved","rejected","escalated"],
      "default": "pending"
    },
    "priority": { "type": "integer", "minimum": 1, "maximum": 5, "default": 3 },
    "assigned_to": { "type": ["string","null"], "description": "Reviewer (human id or AI agent id)." },
    "decision_notes": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "resolved_at": { "type": ["string","null"], "format": "date-time" }
  }
}
