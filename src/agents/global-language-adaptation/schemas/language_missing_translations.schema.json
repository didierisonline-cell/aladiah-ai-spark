{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aladiah.com/schemas/language/language_missing_translations.schema.json",
  "title": "Missing Translation Record",
  "description": "Registry of specific missing translations. Populated by (a) the scanner statically and (b) the runtime fallback logger when a student hits an untranslated surface. Drives the dashboard 'missing' counts and the translation backlog. Maps to language_missing_translations.",
  "type": "object",
  "additionalProperties": false,
  "required": ["language", "surface", "source", "detected_at"],
  "properties": {
    "id": { "type": "string", "description": "UUID." },
    "language": { "type": "string", "description": "Language that is missing the string, e.g. 'bas'." },
    "surface": {
      "type": "string",
      "enum": ["navigation","buttons","ui-labels","alerts-feedback","course-titles","lesson-titles","lesson-body","quiz-questions","quiz-answers","quiz-feedback","simulations","diagrams","transcripts","ai-tutor"]
    },
    "translation_key": { "type": ["string","null"], "description": "LanguageContext key, if UI string." },
    "content_ref": { "type": ["string","null"], "description": "DB ref e.g. 'videos:<id>.title' or 'quiz_questions:<id>'." },
    "source_text": { "type": "string", "description": "The English/baseline text that was shown instead." },
    "served_fallback_language": { "type": "string", "description": "What the student actually saw (e.g. 'fr','en')." },
    "source": {
      "type": "string",
      "description": "How this gap was detected.",
      "enum": ["scanner","runtime-fallback"]
    },
    "occurrences": { "type": "integer", "minimum": 1, "default": 1, "description": "Runtime hit count; incremented on repeat." },
    "status": {
      "type": "string",
      "enum": ["open","queued","translated","wont-translate"],
      "default": "open"
    },
    "detected_at": { "type": "string", "format": "date-time" },
    "last_seen_at": { "type": ["string","null"], "format": "date-time" }
  }
}
