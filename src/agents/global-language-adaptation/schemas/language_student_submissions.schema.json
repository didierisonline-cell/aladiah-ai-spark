{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aladiah.com/schemas/language/language_student_submissions.schema.json",
  "title": "Language Student Submission",
  "description": "Raw language data captured from a student (typed, spoken, correction, or tutor interaction). NEVER auto-published. Always enters at review_state 'unreviewed' and must be reviewed before any promotion to vocabulary or translation memory. Maps to language_student_submissions.",
  "type": "object",
  "additionalProperties": false,
  "required": ["language", "submission_type", "content", "review_state"],
  "properties": {
    "id": { "type": "string", "description": "UUID." },
    "user_id": { "type": "string", "description": "Supabase auth user id of the submitting student." },
    "language": { "type": "string", "description": "Target language, e.g. 'bas'." },
    "submission_type": {
      "type": "string",
      "enum": ["typed","spoken","correction","tutor-interaction","new-word","phrase"]
    },
    "content": { "type": "string", "minLength": 1, "description": "The submitted word/phrase/text in the target language." },
    "pronunciation_note": { "type": "string", "description": "Captured pronunciation guidance (esp. tone for Basaa)." },
    "audio_url": { "type": ["string","null"], "description": "Recording, if spoken." },
    "english_equivalent": { "type": "string" },
    "french_equivalent": { "type": "string" },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "description": "Where/why it was produced.",
      "properties": {
        "course": { "type": "string" },
        "lesson": { "type": "string" },
        "concept": { "type": "string" },
        "user_intent": { "type": "string" }
      }
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1, "description": "System confidence in capture quality." },
    "review_state": {
      "type": "string",
      "enum": ["unreviewed","ai-reviewed","human-reviewed","approved","rejected"],
      "default": "unreviewed"
    },
    "ai_review_notes": { "type": "string" },
    "human_review_notes": { "type": "string" },
    "promoted_to_vocabulary_id": { "type": ["string","null"], "description": "Set when approved and promoted." },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
