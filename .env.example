# Aladiah environment variables — TEMPLATE (no secrets here).
# Copy to .env and fill values locally. NEVER commit .env.
# Production values live in Vercel / Supabase / Railway dashboards, not in git.

# ── CLIENT-EXPOSED (compiled into the frontend bundle BY DESIGN) ──────────────
# Safe to be public ONLY because Supabase RLS + Stripe restricted keys protect them.
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=        # anon key (RLS-protected). NOT the service_role key.
VITE_STRIPE_PUBLISHABLE_KEY=          # pk_… publishable key only (never sk_…)
VITE_STRIPE_PRICE_FOUNDATION=
VITE_STRIPE_PRICE_ACCELERATOR=
VITE_STRIPE_PRICE_ELITE=
VITE_API_URL=
VITE_ELEVENLABS_AGENT_ID=             # public agent id (identifier, not a secret)
VITE_PROF_DIDIER_VOICE_ID=

# ── SERVER-ONLY SECRETS — DO NOT prefix with VITE_, DO NOT ship to client ─────
# These belong in Supabase Edge Function secrets / Vercel / Railway env — never git.
HEYGEN_API_KEY=
ELEVENLABS_API_KEY=                   # was VITE_ELEVENLABS_API_KEY — drop the VITE_ prefix;
                                      # use a server signed-URL for the voice agent.
# STRIPE_SECRET_KEY=                  # sk_… — server only (checkout/webhooks)
# STRIPE_WEBHOOK_SECRET=              # whsec_… — server only
